class Solution {
    public boolean canAliceWin(int[] nums) {
        int asum=0;
        int bsum=0;
        for(int n:nums){
            if(n<10 ){
              asum+=n; 
            }else{
                bsum+=n;
            }
        }
        if(asum==bsum){
            return false;
        }
        return true;
    }
}