class Solution {
    boolean isvowell(char c){
        if(c=='a'||c=='A'||c=='e'||c=='E'||c=='i'||c=='I'||c=='o'||c=='O'||c=='u'||c=='U'){
            return true;
        }
         return false;
    }
    
    public String reverseVowels(String s) {

        char[] c=s.toCharArray();
        int start=0;
        int end=s.length()-1;
        while(start<end){
            if(isvowell(c[start]) && isvowell(c[end])){
                char temp=c[start];
                c[start]=c[end];
                c[end]=temp;
                start++;
                end--;
            }
            else if(!isvowell(c[start])){
                start++;
            }else{
                end--;
            }
        }
        return new String(c);
    }

}
    

