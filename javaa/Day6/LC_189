class LC_189 {
    public void rotate(int[] nums, int k) {
        int n=nums.length;
        k=k%n;
        reversea(nums,0,n-1);
        reversea(nums,0,k-1);
        reversea(nums,k,n-1);
    }
    public void reversea(int[] nums,int start,int end){
        while(start<end){
            int temp=nums[start];
            nums[start]=nums[end];
            nums[end]=temp;
            start++;
            end--;
        }
    }
}