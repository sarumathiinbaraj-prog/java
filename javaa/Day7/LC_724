class Solution {
    public int pivotIndex(int[] nums) {
        int tot=0;
        for(int n:nums){
            tot+=n;
        }
        int lt=0;
        for(int i=0;i<nums.length;i++){
            int rt=tot-lt-nums[i];
            if(lt==rt){
                return i;
            }
            lt+=nums[i];
        }
        return -1;
    }
}