class Solution {
    public int search(int[] n, int target) {
        int s=0;
        int e=n.length-1;
        int m=0;
        while(s<=e){
            m=s+(e-s)/2;
            if(n[m]==target){
                return m;
            }
            if(n[s]<=n[m]){
                if( target>=n[s] && target<=n[m]){
                    e=m-1;

                }else{
                    s=m+1;
                }
            }else{
                if(target>=n[m] && target<=n[e]){
                    s=m+1;
                }else{
                    e=m-1;
                }
                
            }
            
        }
        return -1;
        
    }
}